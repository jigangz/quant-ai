# ===================================
# Quant-AI Environment Variables
# ===================================
# Copy this file to .env and fill in your values

# ===== Environment =====
ENV=dev
DEBUG=true

# ===== Database =====
# Local development (Docker)
DATABASE_URL=postgresql+psycopg://quant:quant@localhost:5432/quantdb
# Or SQLite for quick testing
# DATABASE_URL=sqlite:///./quant.db

# ===== Supabase (optional) =====
# Used for model registry in production
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-key

# ===== Storage =====
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./artifacts
# For S3:
# STORAGE_BACKEND=s3
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret

# ===== Data Providers =====
PROVIDERS_ENABLED=market
MARKET_PROVIDER=yahoo
# For Polygon.io:
# POLYGON_API_KEY=your-key

# ===== Feature Engineering =====
DEFAULT_FEATURE_GROUPS=ta_basic,volatility

# ===== Job Queue (V3) =====
REDIS_URL=redis://localhost:6379/0

# ===== Model Training =====
DEFAULT_MODEL_TYPE=logistic
DEFAULT_HORIZON_DAYS=5
DEFAULT_LABEL_TYPE=direction
TRAINING_MAX_WORKERS=4

# ===== API =====
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
REQUEST_TIMEOUT_SECONDS=300

# ===== Infrastructure Backends (Phase 2.5) =====
# Default: all "redis" or "local" — zero extra infra needed
BROKER_BACKEND=redis
# Options: kafka, redis, memory
QUEUE_BACKEND=redis
# Options: sqs, redis, memory
NOTIFY_BACKEND=redis
# Options: sns, redis, memory
FUNCTIONS_BACKEND=local
# Options: lambda, local

# ===== Kafka (when BROKER_BACKEND=kafka) =====
# Local Docker (start with: docker-compose --profile kafka up):
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
#
# Upstash Kafka (free tier — recommended for production):
# KAFKA_BOOTSTRAP_SERVERS=grizzly-1234-us1-kafka.upstash.io:9092
# KAFKA_SASL_USERNAME=Z3JpenpseTEyMzQ...
# KAFKA_SASL_PASSWORD=ZDI2OWRjMTktNTgw...
#
# Confluent Cloud:
# KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
# KAFKA_SASL_USERNAME=your-api-key
# KAFKA_SASL_PASSWORD=your-api-secret

# ===== Streaming Service (Phase 2.5 Step 9) =====
# Start with: docker-compose --profile streaming up
# Or standalone: python -m app.streaming.service

# ===== AWS Services (when using SQS/SNS/Lambda) =====
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# LocalStack (local dev — start with: docker-compose --profile sqs up):
# SQS_ENDPOINT_URL=http://localhost:4566
# SNS_ENDPOINT_URL=http://localhost:4566
# SAM CLI (local Lambda):
# LAMBDA_ENDPOINT_URL=http://localhost:3001

# ===== Notification Delivery =====
# Discord webhook for alerts (optional):
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url
# Email recipient for alerts (stub — SES integration later):
# ALERT_EMAIL_RECIPIENT=alerts@example.com

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FORMAT=text

# ===== LLM (V3) =====
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ===== Vector Store (V3) =====
# VECTOR_BACKEND=faiss
# PINECONE_API_KEY=...
# PINECONE_ENVIRONMENT=...
